@model List<MultiLanguageDemo.Models.ArticleDto>
@using MultiLanguageDemo.Helpers
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    var categories = ViewBag.Categories as List<MultiLanguageDemo.Models.CategoryDto>;
}
<!-- Hero Section -->
<div class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold mb-3">@Localizer["Global News in Your Language"]</h1>
                <p class="lead mb-4">@Localizer["Stay informed with the latest news from around the world, available in multiple languages. Read, explore, and engage with content tailored for you."]</p>
                <div class="d-flex flex-wrap gap-2">
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var category in categories.Take(4))
                        {
                            <a href="/@ViewBag.CurrentCulture/category/@category.Id" class="btn btn-light btn-lg rounded-pill">
                                <i class="@category.IconClass me-2"></i>@category.Name
                            </a>
                        }
                    }
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <img src="https://cdn.pixabay.com/photo/2018/05/08/08/44/artificial-intelligence-3382507_1280.jpg"
                     class="img-fluid rounded-3 shadow"
                     alt="Global News"
                     style="max-height: 300px;">
            </div>
        </div>
    </div>
</div>

<!-- Featured Articles -->
<section class="container mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">
            <i class="fas fa-star me-2 text-warning"></i>@Localizer["Featured Articles"]
        </h2>
        <a href="#" class="btn btn-outline-primary rounded-pill">@Localizer["View All"]</a>
    </div>

    <div class="row">
        @{
            var featuredArticles = Model?.Where(a => a.IsFeatured).Take(3).ToList();
            if (featuredArticles != null && featuredArticles.Any())
            {
                foreach (var article in featuredArticles)
                {
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="article-card">
                            <div class="position-relative">
                                <img src="@(article.ImageUrl ?? "https://images.unsplash.com/photo-1499750310107-5fef28a66643?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80")"
                                     class="article-image"
                                     alt="@article.Title">
                                <div class="position-absolute top-0 end-0 m-3">
                                    <span class="featured-badge">@Localizer["Featured"]</span>
                                </div>
                            </div>
                            <div class="article-content">
                                <div class="article-category">
                                    <i class="@article.CategoryIcon me-1"></i>@article.CategoryName
                                </div>
                                <h3 class="article-title">@article.Title</h3>
                                <p class="text-muted">@(article.Summary?.Length > 100 ? article.Summary.Substring(0, 100) + "..." : article.Summary)</p>
                                <div class="article-meta">
                                    <span><i class="fas fa-user me-1"></i>@article.AuthorName</span>
                                    <span><i class="far fa-clock me-1"></i>@article.ReadingTime @Localizer["min read"]</span>
                                    <span><i class="far fa-eye me-1"></i>@article.ViewCount</span>
                                </div>
                                <a href="/@ViewBag.CurrentCulture/article/@article.Slug" class="btn btn-primary-custom mt-3 w-100">
                                    @Localizer["Read More"] <i class="fas fa-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <i class="fas fa-newspaper fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">@Localizer["No featured articles available"]</h4>
                </div>
            }
        }
    </div>
</section>

<!-- Categories Section -->
<section class="container mb-5">
    <h2 class="fw-bold mb-4 text-center">
        <i class="fas fa-th-large me-2 text-primary"></i>@Localizer["Browse Categories"]
    </h2>

    <div class="row">
        @if (ViewBag.Categories != null)
        {
            foreach (var category in ViewBag.Categories)
            {
                <div class="col-lg-2 col-md-4 col-sm-6 mb-4">
                    <a href="/@ViewBag.CurrentCulture/category/@category.Id" class="text-decoration-none">
                        <div class="category-card">
                            <div class="category-icon">
                                <i class="@category.IconClass"></i>
                            </div>
                            <h5 class="fw-bold mb-2">@category.Name</h5>
                            <p class="text-muted small">@(category.ArticleCount) @Localizer["articles"]</p>
                        </div>
                    </a>
                </div>
            }
        }
    </div>
</section>

<!-- Recent Articles -->
<section class="container mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">
            <i class="fas fa-history me-2 text-success"></i>@Localizer["Recent Articles"]
        </h2>
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="fas fa-filter me-1"></i>@Localizer["Filter"]
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="#">@Localizer["Latest"]</a></li>
                <li><a class="dropdown-item" href="#">@Localizer["Most Viewed"]</a></li>
                <li><a class="dropdown-item" href="#">@Localizer["Trending"]</a></li>
            </ul>
        </div>
    </div>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            var recentArticles = Model.Where(a => !a.IsFeatured).Take(6).ToList();
            if (recentArticles.Any())
            {
                foreach (var article in recentArticles)
                {
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="article-card">
                            <img src="@(article.ImageUrl ?? "https://images.unsplash.com/photo-1588681664899-f142ff2dc9b1?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80")"
                                 class="article-image"
                                 alt="@article.Title">
                            <div class="article-content">
                                <div class="article-category">
                                    <i class="@article.CategoryIcon me-1"></i>@article.CategoryName
                                </div>
                                <h3 class="article-title">@article.Title</h3>
                                <div class="article-meta">
                                    <span><i class="far fa-calendar me-1"></i>@article.PublishedDate.ToString("MMM dd, yyyy")</span>
                                    <span class="reading-time">
                                        <i class="far fa-clock me-1"></i>@article.ReadingTime @Localizer["min"]
                                    </span>
                                </div>
                                <a href="/@ViewBag.CurrentCulture/article/@article.Slug" class="btn btn-outline-primary rounded-pill mt-3">
                                    @Localizer["Read"] <i class="fas fa-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-4">
                    <p class="text-muted">@Localizer["No recent articles found"]</p>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="fas fa-newspaper fa-3x text-muted mb-3"></i>
                <h4 class="text-muted">@Localizer["No articles available yet"]</h4>
                <p class="text-muted">@Localizer["Check back later for new content"]</p>
            </div>
        }
    </div>

    @if (Model != null && Model.Count > 6)
    {
        <div class="text-center mt-4">
            <a href="#" class="btn btn-primary-custom btn-lg">
                @Localizer["Load More Articles"] <i class="fas fa-arrow-down ms-2"></i>
            </a>
        </div>
    }
</section>

<!-- Newsletter Section -->
<section class="container mb-5">
    <div class="bg-primary text-white rounded-3 p-5 text-center" style="background: linear-gradient(135deg, #4361ee, #3a0ca3);">
        <h2 class="fw-bold mb-3">@Localizer["Never Miss an Update"]</h2>
        <p class="lead mb-4">@Localizer["Subscribe to our newsletter and get the latest news delivered directly to your inbox."]</p>
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="input-group input-group-lg">
                    <input type="email" class="form-control rounded-pill" placeholder="@Localizer["Your email address"]">
                    <button class="btn btn-light rounded-pill ms-2 px-4" type="button">
                        @Localizer["Subscribe"] <i class="fas fa-paper-plane ms-2"></i>
                    </button>
                </div>
                <p class="small mt-3 opacity-75">@Localizer["We respect your privacy. Unsubscribe at any time."]</p>
            </div>
        </div>
    </div>
</section>